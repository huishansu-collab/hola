  "utterances": [
    {
      "id": "u001",
      "speaker": "user",
      "speaker_id": "user_1",
      "text": "帮我回一下强哥刚发的那条消息。",
      "start_at_ms": 0,
      "end_at_ms": 2480
    },
    {
      "id": "u002",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "嗯……",
      "start_at_ms": 2800,
      "end_at_ms": 3380
    },
    {
      "id": "u003",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "他问周六踢球去不去。你想咋回？",
      "start_at_ms": 3600,
      "end_at_ms": 6900
    },
    {
      "id": "u004",
      "speaker": "user",
      "speaker_id": "user_1",
      "text": "回他去，让他把时间地点发我。",
      "start_at_ms": 6900,
      "end_at_ms": 9920
    },
    {
      "id": "u005",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "嗯……",
      "start_at_ms": 10000,
      "end_at_ms": 10440
    },
    {
      "id": "u006",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "那我这么发：‘去！几点开球？时间地点发我——",
      "start_at_ms": 10800,
      "end_at_ms": 14400
    },
    {
      "id": "u007",
      "speaker": "user",
      "speaker_id": "user_1",
      "text": "等下——",
      "start_at_ms": 14000,
      "end_at_ms": 14420
    },
    {
      "id": "u008",
      "speaker": "user",
      "speaker_id": "user_1",
      "text": "别说‘去’，说‘应该能去’，我还没跟家里说。",
      "start_at_ms": 14420,
      "end_at_ms": 18130
    },
    {
      "id": "u009",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "嗯……",
      "start_at_ms": 18400,
      "end_at_ms": 18900
    },
    {
      "id": "u010",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "改好了：‘应该能去，几点开球？时间地点发我，今晚定。’这么发？",
      "start_at_ms": 19200,
      "end_at_ms": 26820
    },
    {
      "id": "u011",
      "speaker": "user",
      "speaker_id": "user_1",
      "text": "嗯，发吧。",
      "start_at_ms": 26820,
      "end_at_ms": 28360
    },
    {
      "id": "u012",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "嗯。",
      "start_at_ms": 28400,
      "end_at_ms": 28640
    },
    {
      "id": "u013",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "发了。",
      "start_at_ms": 28800,
      "end_at_ms": 29140
    }
  ],
