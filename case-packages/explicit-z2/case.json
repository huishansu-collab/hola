      "end_at_ms": 40800
    },
    {
      "id": "u006",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "好。",
      "start_at_ms": 40800,
      "end_at_ms": 41200
    },
    {
      "id": "u007",
      "speaker": "assistant",
      "speaker_id": "assistant",
      "text": "发了。地址也转你收藏了，到时候点开就能导。",
      "start_at_ms": 41600,
      "end_at_ms": 45200
    },
    {
      "id": "u008",
      "speaker": "user",
      "speaker_id": "user_1",
