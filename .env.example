# 语音生成:OpenAI 与 千问(阿里云百炼 DashScope)二选一或都配。复制为 .env 后填入,不要提交到仓库。
# 两家都配时默认用 OpenAI;TTS_PROVIDER=qwen 可切换,命令行 --provider 优先。
TTS_PROVIDER=openai

# —— OpenAI ——
OPENAI_API_KEY=sk-...
# 可选:模型(gpt-4o-mini-tts 支持 instructions 音色描述;tts-1 / tts-1-hd 不支持)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# 可选:自定义 API 地址(代理 / 兼容网关)
OPENAI_BASE_URL=https://api.openai.com/v1

# —— 千问 TTS(DashScope)——
DASHSCOPE_API_KEY=sk-...
# 可选:模型(qwen3-tts-flash 音色最全;qwen-tts 为旧版)
QWEN_TTS_MODEL=qwen3-tts-flash
# 可选:国际站用 https://dashscope-intl.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 可选:服务端口
PORT=5173
